<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Card Píldora del Logo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMonkey"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="42dp"
        app:strokeColor="@color/surface_pill"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivMonkey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvBlockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Acceso Restringido"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBlockReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Contenido bloqueado por las políticas de seguridad activas."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- Píldora de estado minimalista -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface_pill"
        app:cardCornerRadius="18dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="AntiMono • Escudo Activo"
            android:textColor="@color/ios_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnderstood"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/accent"
        app:cornerRadius="26dp"
        android:text="Cerrar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>
