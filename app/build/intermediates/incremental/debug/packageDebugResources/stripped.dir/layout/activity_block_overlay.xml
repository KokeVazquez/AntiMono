<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Card Píldora del Changuito -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMonkey"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="40dp"
        app:strokeColor="@color/ios_red"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/ivMonkey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvBlockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="¡Changuito al Calabozo! 🐵⛓️"
        android:textColor="@color/ios_red"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBlockReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="El impulso fue neutralizado con éxito."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- Píldora motivadora -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface_pill"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="✨ Respira profundo. Tú tienes el control."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnderstood"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/accent"
        app:cornerRadius="26dp"
        android:text="Volver al Inicio"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>
