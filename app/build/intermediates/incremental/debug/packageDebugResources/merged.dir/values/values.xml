    <string name="accessibility_service_description">Servicio de protección y bloqueo de contenido no deseado, sitios web restringidos y protección contra desinstalación no autorizada.</string>
    <string name="app_name">AntiMono</string>
    <string name="device_admin_description">Protección activa de AntiMono para evitar la desinstalación y alteración sin el PIN de seguridad.</string>
    <string name="device_admin_warning">Esta aplicación está protegida. Para desactivar los privilegios de administración o desinstalarla, debes ingresar tu PIN en la aplicación.</string>
    <style name="Theme.AntiMono" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    <style name="Widget.AntiMono.Switch.IOS" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="thumbIcon">@null</item>
    </style>
